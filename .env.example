# ==============================================================================
# ForestSentinel ETL Configuration
# ==============================================================================

# NASA FIRMS Map Key (Obtain from: https://firms.modaps.eosdis.nasa.gov/api/map_key)
NASA_FIRMS_MAP_KEY=replace_with_your_real_map_key

# NASA FIRMS Source (e.g., VIIRS_NOAA21_NRT, VIIRS_SNPP_NRT, MODIS_NRT)
FIRMS_SOURCE=VIIRS_NOAA21_NRT

# Pilot Study Area Bounding Box: west,south,east,north
# Default: Amazon Pilot Study Region (-62W, -10S to -58W, -6N)
AMAZON_BBOX=-62,-10,-58,-6

# Query Day Range (NASA FIRMS Area API expects 1 to 5 days)
DAY_RANGE=5

# Analysis Grid Cell Size in decimal degrees (e.g. 0.25 deg ~ 27.7 km at equator)
GRID_SIZE_DEGREES=0.25

# Firebase Cloud Firestore Configuration
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=replace_with_your_firebase_project_id

# Logging Configuration (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ==============================================================================
# Part 3 - Conservation Exposure Analysis Configuration
# ==============================================================================
# IUCN Red List API v4 Configuration (Optional; obtain from https://api.iucnredlist.org)
IUCN_API_TOKEN=replace_with_your_iucn_api_token
IUCN_API_BASE_URL=https://api.iucnredlist.org

# GBIF Occurrence Search Configuration
GBIF_MAX_RECORDS_PER_GRID=300
GBIF_REQUEST_TIMEOUT_SECONDS=30
